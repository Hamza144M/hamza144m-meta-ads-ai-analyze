# Public URL of the Express API (apps/api). Leave empty to run the website on its own
# (e.g. Vercel only): files are parsed by this app's /api/local routes and reports are
# saved in the visitor's browser.
NEXT_PUBLIC_API_URL=

# ---- AI (server-side, used only when NEXT_PUBLIC_API_URL is empty) ----
# Claude (recommended): answers the AI analysis and "Ask AI" chat when set.
# Get a key at console.anthropic.com. ANTHROPIC_MODEL is optional (default claude-opus-5-5;
# claude-sonnet-5-5 or claude-haiku-5-5 cost less per answer).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional OpenAI-compatible provider: used when ANTHROPIC_API_KEY is empty, or as a backup
# if Claude is unavailable. With no AI key at all, a rule-based analysis is used.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: second model tried automatically when AI_MODEL is busy or rate limited
# (busy/rate-limited requests are also retried a few times with backoff first).
AI_FALLBACK_MODEL=

# ---- Firebase Authentication (optional) ----
# These are public web-app config values from the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SEO ----
# Your public domain, e.g. https://metaadsanalyzer.com (on Vercel the production domain is used if empty)
# NEXT_PUBLIC_SITE_URL is listed above.
# Google Search Console "HTML tag" verification: paste only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Accounts & daily limits (Vercel-only mode) ----
# With the Firebase keys above, users must sign up; free accounts get 3 audits a day.
# Supabase stores plans and usage (run supabase/schema.sql first). Server-only secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Lemon Squeezy webhook signing secret (Settings → Webhooks), marks paying users as Pro/Agency.
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---- Payments ----
# Hosted checkout links from your payment provider (e.g. Lemon Squeezy → Products → Share).
NEXT_PUBLIC_CHECKOUT_URL_PRO=
NEXT_PUBLIC_CHECKOUT_URL_AGENCY=
# Optional: shown as "Contact us" on paid plans that have no checkout link yet.
NEXT_PUBLIC_CONTACT_EMAIL=
