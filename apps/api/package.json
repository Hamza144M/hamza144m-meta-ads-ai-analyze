{
  "name": "@maa/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express API: report upload and parsing, storage, AI analysis.",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../../packages/core",
    "dev": "tsx watch src/index.ts",
