    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@maa/core": "0.1.0",
    "@supabase/supabase-js": "2.119.2",
    "cors": "2.8.6",
