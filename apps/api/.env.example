# ---- Server ----
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Max upload size in megabytes
MAX_UPLOAD_MB=15

# ---- Storage (optional) ----
# Leave empty to keep reports in memory (fine for local testing; lost on restart).
SUPABASE_URL=
# Service role key: server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI ----
# Claude (recommended): answers the AI analysis and "Ask AI" chat when set.
# Get a key at console.anthropic.com. ANTHROPIC_MODEL is optional (default claude-opus-5-5;
# claude-sonnet-5-5 or claude-haiku-5-5 cost less per answer).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional OpenAI-compatible provider: used when ANTHROPIC_API_KEY is empty, or as a backup
# if Claude is unavailable. With no AI key at all, a rule-based analysis is used.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: second model tried automatically when AI_MODEL is busy or rate limited
# (busy/rate-limited requests are also retried a few times with backoff first).
AI_FALLBACK_MODEL=

# ---- Auth (optional) ----
# Firebase Admin service account, as JSON on one line or base64.
FIREBASE_SERVICE_ACCOUNT=
